{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>eleboucher/renovate-config"],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 5am on monday"]
  },
  "packageRules": [
    {
      "description": "Keep rust-toolchain.toml and mise.toml in sync on Rust bumps",
      "matchDepNames": ["rust"],
      "groupName": "rust toolchain"
    },
    {
      "description": "Group all minor and patch updates into a single PR",
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    },
    {
      "description": "No breaking '!' on major updates; a dep/CI bump must not force a product major",
      "matchUpdateTypes": ["major"],
      "commitMessagePrefix": "{{semanticCommitType}}({{semanticCommitScope}}):"
    }
  ]
}
