{
	admin off

	# L4 byte-shuffle: bind :443, prepend PROXY v2, forward to towonel.
	# towonel handles SNI peeking, TLS termination, and ACME (TLS-ALPN-01).
	# Mount your own /etc/caddy/Caddyfile to add extra vhosts on :80.
	layer4 {
		:443 {
			@tls tls
			route @tls {
				proxy {
					upstream 127.0.0.1:4443
					proxy_protocol v2
				}
			}
		}
	}
}
