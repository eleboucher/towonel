/target

# Key material — never commit
*.key
/hub.key
/agent.key
/tenant.key
/node.key

# E2E test fixture TLS material — regenerated by tests/e2e/fixtures/make-fixtures.sh
# (run automatically by `make e2e`). Keys are covered by *.key above.
/tests/e2e/fixtures/hub-tls.key
/tests/e2e/fixtures/*.pem

# Local runtime state
/hub.db
*.sqlite
*.sqlite-journal
/.dev/

# Vendored Helm chart dependencies (fetched via `helm dependency build`);
# Chart.lock is committed to pin the resolved version.
/charts/*/charts/
