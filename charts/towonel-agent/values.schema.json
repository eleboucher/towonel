{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "affinity": {
      "description": "Affinity rules for pod scheduling.",
      "required": [],
      "title": "affinity",
      "type": "object"
    },
    "agent": {
      "properties": {
        "healthPort": {
          "default": 9090,
          "description": "Port serving health and Prometheus metrics (TOWONEL_AGENT_HEALTH_LISTEN_ADDR).",
          "title": "healthPort",
          "type": "integer"
        },
        "inviteTokenSecret": {
          "description": "- name: stunner-turn-udp\n  origin: stunner.network.svc.cluster.local:3478\n  listen_port: 3478",
          "properties": {
            "key": {
              "default": "TOWONEL_INVITE_TOKEN",
              "description": "Key inside the Secret.",
              "title": "key",
              "type": "string"
            },
            "name": {
              "default": "",
              "description": "Name of the Secret holding the invite token (TOWONEL_INVITE_TOKEN).\nLeave empty to skip the env var.",
              "title": "name",
              "type": "string"
            }
          },
          "required": [],
          "title": "inviteTokenSecret",
          "type": "object"
        },
        "logLevel": {
          "default": "info",
          "description": "Log level (RUST_LOG).",
          "title": "logLevel",
          "type": "string"
        },
        "services": {
          "description": "HTTPS services exposed through the tunnel (TOWONEL_AGENT_SERVICES).",
          "items": {
            "required": []
          },
          "title": "services",
          "type": "array"
        },
        "tcpServices": {
          "description": "- hostname: \"*.example.com\"\n  origin: envoy-external.network.svc.cluster.local:443\nRaw TCP services exposed through the tunnel (TOWONEL_AGENT_TCP_SERVICES).",
          "items": {
            "required": []
          },
          "title": "tcpServices",
          "type": "array"
        },
        "udpServices": {
          "description": "- name: forgejo-ssh\n  origin: envoy-external.network.svc.cluster.local:2222\n  listen_port: 2222\nUDP services exposed through the tunnel (TOWONEL_AGENT_UDP_SERVICES).",
          "items": {
            "required": []
          },
          "title": "udpServices",
          "type": "array"
        }
      },
      "required": [],
      "title": "agent",
      "type": "object"
    },
    "deploymentAnnotations": {
      "description": "Annotations added to the Deployment (e.g. reloader.stakater.com/auto).",
      "required": [],
      "title": "deploymentAnnotations",
      "type": "object"
    },
    "directConnect": {
      "description": "Relay-less direct connectivity: bind a fixed iroh UDP port, expose it as a\nNodePort, and advertise the node IP + nodePort via autodiscovery (also grants\nNode/Service read RBAC and mounts the token). The node address must be\nreachable from the edge.",
      "properties": {
        "annotations": {
          "description": "Annotations for the direct (NodePort) Service.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "description": "Enable relay-less direct connectivity (NodePort + node autodiscovery).",
          "title": "enabled",
          "type": "boolean"
        },
        "irohPort": {
          "default": 51820,
          "description": "Fixed iroh UDP port the agent binds and the NodePort targets (TOWONEL_AGENT_IROH_PORT).",
          "title": "irohPort",
          "type": "integer"
        },
        "nodePort": {
          "default": "null",
          "description": "Explicit nodePort for the iroh UDP port; null lets Kubernetes assign one.",
          "required": [],
          "title": "nodePort",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [],
      "title": "directConnect",
      "type": "object"
    },
    "env": {
      "description": "Extra environment variables passed to the container (k8s EnvVar list).",
      "items": {
        "required": []
      },
      "title": "env",
      "type": "array"
    },
    "envFrom": {
      "description": "Extra envFrom sources.",
      "items": {
        "required": []
      },
      "title": "envFrom",
      "type": "array"
    },
    "extraLocalAddrs": {
      "default": "",
      "description": "Reachable local addresses advertised to edges, comma-separated host:port (TOWONEL_AGENT_EXTRA_LOCAL_ADDRS).",
      "title": "extraLocalAddrs",
      "type": "string"
    },
    "fullnameOverride": {
      "default": "",
      "description": "Override the full release name.",
      "title": "fullnameOverride",
      "type": "string"
    },
    "global": {
      "description": "Global values are values that can be accessed from any chart or subchart by exactly the same name.",
      "required": [],
      "title": "global",
      "type": "object"
    },
    "image": {
      "properties": {
        "digest": {
          "default": "",
          "description": "Pin the image by digest (sha256:...); when set, overrides the tag.\nThe release pipeline fills it with the published image's digest.",
          "title": "digest",
          "type": "string"
        },
        "pullPolicy": {
          "default": "IfNotPresent",
          "description": "Image pull policy.",
          "title": "pullPolicy",
          "type": "string"
        },
        "repository": {
          "default": "codeberg.org/towonel/towonel-agent",
          "description": "Image repository.",
          "title": "repository",
          "type": "string"
        },
        "tag": {
          "default": "",
          "description": "Overrides the image tag; defaults to the chart appVersion.",
          "title": "tag",
          "type": "string"
        }
      },
      "required": [],
      "title": "image",
      "type": "object"
    },
    "imagePullSecrets": {
      "description": "Image pull secrets for private registries.",
      "items": {
        "required": []
      },
      "title": "imagePullSecrets",
      "type": "array"
    },
    "livenessProbe": {
      "description": "Liveness probe.",
      "properties": {
        "failureThreshold": {
          "default": 3,
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "properties": {
            "path": {
              "default": "/healthz",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "metrics",
              "title": "port",
              "type": "string"
            }
          },
          "required": [],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 10,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 30,
          "title": "periodSeconds",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 3,
          "title": "timeoutSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "livenessProbe",
      "type": "object"
    },
    "monitoring": {
      "properties": {
        "dashboards": {
          "properties": {
            "annotations": {
              "description": "Annotations added to the dashboard ConfigMap.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Render the Grafana dashboard ConfigMap (for grafana-operator or the\nkube-prometheus-stack sidecar).",
              "title": "enabled",
              "type": "boolean"
            },
            "grafanaOperator": {
              "properties": {
                "allowCrossNamespaceImport": {
                  "default": true,
                  "description": "If true allows for a Grafana in any namespace to access this GrafanaDashboard.",
                  "title": "allowCrossNamespaceImport",
                  "type": "boolean"
                },
                "enabled": {
                  "default": false,
                  "description": "Render a GrafanaDashboard CR (grafana-operator) instead of a sidecar ConfigMap.",
                  "title": "enabled",
                  "type": "boolean"
                },
                "folder": {
                  "default": "",
                  "description": "Folder to create the dashboard in.",
                  "title": "folder",
                  "type": "string"
                },
                "matchLabels": {
                  "description": "Selector labels for the Grafana instance. Must be set when enabled.",
                  "required": [],
                  "title": "matchLabels",
                  "type": "object"
                },
                "resyncPeriod": {
                  "default": "10m",
                  "description": "Resync period for the Grafana operator to check for updates to the dashboard.",
                  "title": "resyncPeriod",
                  "type": "string"
                }
              },
              "required": [],
              "title": "grafanaOperator",
              "type": "object"
            },
            "labels": {
              "description": "Labels added to the dashboard ConfigMap.",
              "required": [],
              "title": "labels",
              "type": "object"
            },
            "namespace": {
              "default": "",
              "description": "Namespace for the dashboard objects; defaults to the release namespace.",
              "title": "namespace",
              "type": "string"
            }
          },
          "required": [],
          "title": "dashboards",
          "type": "object"
        },
        "prometheusRule": {
          "properties": {
            "additionalRuleLabels": {
              "description": "Extra labels added to every alert rule (e.g. cluster).",
              "required": [],
              "title": "additionalRuleLabels",
              "type": "object"
            },
            "annotations": {
              "description": "PrometheusRule annotations.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Create a PrometheusRule with the agent alerting rules.",
              "title": "enabled",
              "type": "boolean"
            },
            "labels": {
              "description": "PrometheusRule labels.",
              "required": [],
              "title": "labels",
              "type": "object"
            }
          },
          "required": [],
          "title": "prometheusRule",
          "type": "object"
        },
        "serviceMonitor": {
          "properties": {
            "annotations": {
              "description": "ServiceMonitor annotations.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Create a Prometheus Operator ServiceMonitor (requires its CRDs).",
              "title": "enabled",
              "type": "boolean"
            },
            "interval": {
              "default": "30s",
              "description": "Scrape interval.",
              "title": "interval",
              "type": "string"
            },
            "labels": {
              "description": "ServiceMonitor labels.",
              "required": [],
              "title": "labels",
              "type": "object"
            },
            "metricRelabelings": {
              "description": "Prometheus metric relabelings.",
              "items": {
                "required": []
              },
              "title": "metricRelabelings",
              "type": "array"
            },
            "path": {
              "default": "/metrics",
              "description": "Metrics path.",
              "title": "path",
              "type": "string"
            },
            "relabelings": {
              "description": "Prometheus relabelings (applied before scraping).",
              "items": {
                "required": []
              },
              "title": "relabelings",
              "type": "array"
            },
            "scrapeTimeout": {
              "default": "10s",
              "description": "Scrape timeout.",
              "title": "scrapeTimeout",
              "type": "string"
            }
          },
          "required": [],
          "title": "serviceMonitor",
          "type": "object"
        }
      },
      "required": [],
      "title": "monitoring",
      "type": "object"
    },
    "nameOverride": {
      "default": "",
      "description": "Override the chart name used in resource names.",
      "title": "nameOverride",
      "type": "string"
    },
    "nodeSelector": {
      "description": "Node selector for pod scheduling.",
      "required": [],
      "title": "nodeSelector",
      "type": "object"
    },
    "podAnnotations": {
      "description": "Annotations added to the pod.",
      "required": [],
      "title": "podAnnotations",
      "type": "object"
    },
    "podLabels": {
      "description": "Labels added to the pod.",
      "required": [],
      "title": "podLabels",
      "type": "object"
    },
    "podSecurityContext": {
      "description": "Pod-level securityContext (runs as non-root uid/gid 10001).",
      "properties": {
        "fsGroup": {
          "default": 10001,
          "title": "fsGroup",
          "type": "integer"
        },
        "runAsGroup": {
          "default": 10001,
          "title": "runAsGroup",
          "type": "integer"
        },
        "runAsNonRoot": {
          "default": true,
          "title": "runAsNonRoot",
          "type": "boolean"
        },
        "runAsUser": {
          "default": 10001,
          "title": "runAsUser",
          "type": "integer"
        },
        "seccompProfile": {
          "properties": {
            "type": {
              "default": "RuntimeDefault",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "seccompProfile",
          "type": "object"
        }
      },
      "required": [],
      "title": "podSecurityContext",
      "type": "object"
    },
    "readinessProbe": {
      "description": "Readiness probe.",
      "properties": {
        "failureThreshold": {
          "default": 3,
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "properties": {
            "path": {
              "default": "/healthz",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "metrics",
              "title": "port",
              "type": "string"
            }
          },
          "required": [],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 3,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 10,
          "title": "periodSeconds",
          "type": "integer"
        },
        "timeoutSeconds": {
          "default": 3,
          "title": "timeoutSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "readinessProbe",
      "type": "object"
    },
    "relayUrl": {
      "default": "",
      "description": "Relay URL(s), comma-separated (TOWONEL_AGENT_RELAY_URL). Empty uses the hub-advertised relay.",
      "title": "relayUrl",
      "type": "string"
    },
    "replicaCount": {
      "default": 2,
      "description": "Number of agent replicas (two give edge-session redundancy).",
      "title": "replicaCount",
      "type": "integer"
    },
    "resources": {
      "description": "Pod resource requests/limits.",
      "properties": {
        "limits": {
          "properties": {
            "memory": {
              "default": "256Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [],
          "title": "limits",
          "type": "object"
        },
        "requests": {
          "properties": {
            "cpu": {
              "default": "50m",
              "title": "cpu",
              "type": "string"
            },
            "memory": {
              "default": "128Mi",
              "title": "memory",
              "type": "string"
            }
          },
          "required": [],
          "title": "requests",
          "type": "object"
        }
      },
      "required": [],
      "title": "resources",
      "type": "object"
    },
    "securityContext": {
      "description": "Container securityContext (no privilege escalation, read-only root\nfilesystem, drops ALL capabilities).",
      "properties": {
        "allowPrivilegeEscalation": {
          "default": false,
          "title": "allowPrivilegeEscalation",
          "type": "boolean"
        },
        "capabilities": {
          "properties": {
            "drop": {
              "items": {
                "anyOf": [
                  {
                    "type": "string"
                  }
                ],
                "required": []
              },
              "title": "drop",
              "type": "array"
            }
          },
          "required": [],
          "title": "capabilities",
          "type": "object"
        },
        "readOnlyRootFilesystem": {
          "default": true,
          "title": "readOnlyRootFilesystem",
          "type": "boolean"
        }
      },
      "required": [],
      "title": "securityContext",
      "type": "object"
    },
    "service": {
      "description": "Service configuration for the metrics endpoint.",
      "properties": {
        "annotations": {
          "description": "Annotations for the Service.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "type": {
          "default": "ClusterIP",
          "description": "Service type.",
          "title": "type",
          "type": "string"
        }
      },
      "required": [],
      "title": "service",
      "type": "object"
    },
    "serviceAccount": {
      "properties": {
        "annotations": {
          "description": "Annotations for the ServiceAccount.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "automount": {
          "default": false,
          "description": "Automount the API token (off by default: the agent does not talk to the cluster API).",
          "title": "automount",
          "type": "boolean"
        },
        "create": {
          "default": true,
          "description": "Create a ServiceAccount.",
          "title": "create",
          "type": "boolean"
        },
        "name": {
          "default": "",
          "description": "ServiceAccount name; generated from the release name if empty.",
          "title": "name",
          "type": "string"
        }
      },
      "required": [],
      "title": "serviceAccount",
      "type": "object"
    },
    "startupProbe": {
      "description": "Startup probe (on the named metrics port).",
      "properties": {
        "failureThreshold": {
          "default": 30,
          "title": "failureThreshold",
          "type": "integer"
        },
        "httpGet": {
          "properties": {
            "path": {
              "default": "/healthz",
              "title": "path",
              "type": "string"
            },
            "port": {
              "default": "metrics",
              "title": "port",
              "type": "string"
            }
          },
          "required": [],
          "title": "httpGet",
          "type": "object"
        },
        "initialDelaySeconds": {
          "default": 2,
          "title": "initialDelaySeconds",
          "type": "integer"
        },
        "periodSeconds": {
          "default": 2,
          "title": "periodSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "startupProbe",
      "type": "object"
    },
    "terminationGracePeriodSeconds": {
      "default": 30,
      "description": "Grace period for in-flight streams on shutdown.",
      "title": "terminationGracePeriodSeconds",
      "type": "integer"
    },
    "tolerations": {
      "description": "Tolerations for pod scheduling.",
      "items": {
        "required": []
      },
      "title": "tolerations",
      "type": "array"
    },
    "volumeMounts": {
      "description": "Additional volume mounts on the container.",
      "items": {
        "required": []
      },
      "title": "volumeMounts",
      "type": "array"
    },
    "volumes": {
      "description": "Additional volumes on the Deployment.",
      "items": {
        "required": []
      },
      "title": "volumes",
      "type": "array"
    }
  },
  "required": [],
  "type": "object"
}
