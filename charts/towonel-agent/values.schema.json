{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
    "agent": {
      "description": "Friendly agent configuration (derived into the container env / ports).",
      "properties": {
        "healthBindAddress": {
          "default": "0.0.0.0",
          "description": "Bind address for the health/metrics listener. \"[::]\" is dual-stack.",
          "title": "healthBindAddress",
          "type": "string"
        },
        "healthPort": {
          "default": 9090,
          "description": "Port serving health and Prometheus metrics (TOWONEL_AGENT_HEALTH_LISTEN_ADDR).",
          "title": "healthPort",
          "type": "integer"
        },
        "inviteTokenSecret": {
          "description": "- name: stunner-turn-udp\n  origin: stunner.network.svc.cluster.local:3478\n  listen_port: 3478",
          "properties": {
            "key": {
              "default": "TOWONEL_INVITE_TOKEN",
              "description": "Key inside the Secret.",
              "title": "key",
              "type": "string"
            },
            "name": {
              "default": "",
              "description": "Name of the Secret holding the invite token (TOWONEL_INVITE_TOKEN).\nLeave empty to skip the env var.",
              "title": "name",
              "type": "string"
            }
          },
          "required": [],
          "title": "inviteTokenSecret",
          "type": "object"
        },
        "logLevel": {
          "default": "info",
          "description": "Log level (RUST_LOG).",
          "title": "logLevel",
          "type": "string"
        },
        "services": {
          "description": "HTTPS services exposed through the tunnel (TOWONEL_AGENT_SERVICES).",
          "items": {
            "required": []
          },
          "title": "services",
          "type": "array"
        },
        "tcpServices": {
          "description": "- hostname: \"*.example.com\"\n  origin: envoy-external.network.svc.cluster.local:443\nRaw TCP services exposed through the tunnel (TOWONEL_AGENT_TCP_SERVICES).",
          "items": {
            "required": []
          },
          "title": "tcpServices",
          "type": "array"
        },
        "udpServices": {
          "description": "- name: forgejo-ssh\n  origin: envoy-external.network.svc.cluster.local:2222\n  listen_port: 2222\n  proxy_protocol: v2\nUDP services exposed through the tunnel (TOWONEL_AGENT_UDP_SERVICES).",
          "items": {
            "required": []
          },
          "title": "udpServices",
          "type": "array"
        }
      },
      "required": [],
      "title": "agent",
      "type": "object"
    },
    "configMaps": {
      "description": "Kubernetes ConfigMaps to be generated by the chart. Additional ConfigMaps\ncan be added by adding a dictionary key similar to the 'config' object.",
      "required": [],
      "title": "configMaps",
      "type": "object"
    },
    "configMapsFromFolder": {
      "description": "Generate ConfigMaps from files in the chart filesystem",
      "properties": {
        "autoDetectBinary": {
          "default": false,
          "description": "(string) Base path containing configmap subfolders\nbasePath:",
          "title": "autoDetectBinary",
          "type": "boolean"
        },
        "configMapsOverrides": {
          "required": [],
          "title": "configMapsOverrides",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        }
      },
      "required": [],
      "title": "configMapsFromFolder",
      "type": "object"
    },
    "controllers": {
      "properties": {
        "main": {
          "properties": {
            "annotations": {
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "containers": {
              "properties": {
                "main": {
                  "properties": {
                    "image": {
                      "properties": {
                        "digest": {
                          "default": "",
                          "description": "Pin the image by digest (sha256:...); the release pipeline fills it.",
                          "title": "digest",
                          "type": "string"
                        },
                        "pullPolicy": {
                          "default": "IfNotPresent",
                          "description": "Image pull policy.",
                          "title": "pullPolicy",
                          "type": "string"
                        },
                        "repository": {
                          "default": "codeberg.org/towonel/towonel-agent",
                          "description": "Image repository.",
                          "title": "repository",
                          "type": "string"
                        },
                        "tag": {
                          "default": "{{ .Chart.AppVersion }}",
                          "description": "Image tag; defaults to the chart appVersion.",
                          "title": "tag",
                          "type": "string"
                        }
                      },
                      "required": [],
                      "title": "image",
                      "type": "object"
                    },
                    "probes": {
                      "description": "env and ports are derived from the agent config by templates/_config.tpl.",
                      "properties": {
                        "liveness": {
                          "properties": {
                            "enabled": {
                              "default": true,
                              "title": "enabled",
                              "type": "boolean"
                            },
                            "path": {
                              "default": "/healthz",
                              "title": "path",
                              "type": "string"
                            },
                            "port": {
                              "default": "metrics",
                              "title": "port",
                              "type": "string"
                            },
                            "spec": {
                              "properties": {
                                "failureThreshold": {
                                  "default": 3,
                                  "title": "failureThreshold",
                                  "type": "integer"
                                },
                                "initialDelaySeconds": {
                                  "default": 10,
                                  "title": "initialDelaySeconds",
                                  "type": "integer"
                                },
                                "periodSeconds": {
                                  "default": 30,
                                  "title": "periodSeconds",
                                  "type": "integer"
                                },
                                "timeoutSeconds": {
                                  "default": 3,
                                  "title": "timeoutSeconds",
                                  "type": "integer"
                                }
                              },
                              "required": [],
                              "title": "spec",
                              "type": "object"
                            },
                            "type": {
                              "default": "HTTP",
                              "title": "type",
                              "type": "string"
                            }
                          },
                          "required": [],
                          "title": "liveness",
                          "type": "object"
                        },
                        "readiness": {
                          "properties": {
                            "enabled": {
                              "default": true,
                              "title": "enabled",
                              "type": "boolean"
                            },
                            "path": {
                              "default": "/healthz",
                              "title": "path",
                              "type": "string"
                            },
                            "port": {
                              "default": "metrics",
                              "title": "port",
                              "type": "string"
                            },
                            "spec": {
                              "properties": {
                                "failureThreshold": {
                                  "default": 3,
                                  "title": "failureThreshold",
                                  "type": "integer"
                                },
                                "initialDelaySeconds": {
                                  "default": 3,
                                  "title": "initialDelaySeconds",
                                  "type": "integer"
                                },
                                "periodSeconds": {
                                  "default": 10,
                                  "title": "periodSeconds",
                                  "type": "integer"
                                },
                                "timeoutSeconds": {
                                  "default": 3,
                                  "title": "timeoutSeconds",
                                  "type": "integer"
                                }
                              },
                              "required": [],
                              "title": "spec",
                              "type": "object"
                            },
                            "type": {
                              "default": "HTTP",
                              "title": "type",
                              "type": "string"
                            }
                          },
                          "required": [],
                          "title": "readiness",
                          "type": "object"
                        },
                        "startup": {
                          "properties": {
                            "enabled": {
                              "default": true,
                              "title": "enabled",
                              "type": "boolean"
                            },
                            "path": {
                              "default": "/healthz",
                              "title": "path",
                              "type": "string"
                            },
                            "port": {
                              "default": "metrics",
                              "title": "port",
                              "type": "string"
                            },
                            "spec": {
                              "properties": {
                                "failureThreshold": {
                                  "default": 30,
                                  "title": "failureThreshold",
                                  "type": "integer"
                                },
                                "initialDelaySeconds": {
                                  "default": 2,
                                  "title": "initialDelaySeconds",
                                  "type": "integer"
                                },
                                "periodSeconds": {
                                  "default": 2,
                                  "title": "periodSeconds",
                                  "type": "integer"
                                }
                              },
                              "required": [],
                              "title": "spec",
                              "type": "object"
                            },
                            "type": {
                              "default": "HTTP",
                              "title": "type",
                              "type": "string"
                            }
                          },
                          "required": [],
                          "title": "startup",
                          "type": "object"
                        }
                      },
                      "required": [],
                      "title": "probes",
                      "type": "object"
                    },
                    "resources": {
                      "description": "Pod resource requests/limits.",
                      "properties": {
                        "limits": {
                          "properties": {
                            "memory": {
                              "default": "256Mi",
                              "title": "memory",
                              "type": "string"
                            }
                          },
                          "required": [],
                          "title": "limits",
                          "type": "object"
                        },
                        "requests": {
                          "properties": {
                            "cpu": {
                              "default": "50m",
                              "title": "cpu",
                              "type": "string"
                            },
                            "memory": {
                              "default": "128Mi",
                              "title": "memory",
                              "type": "string"
                            }
                          },
                          "required": [],
                          "title": "requests",
                          "type": "object"
                        }
                      },
                      "required": [],
                      "title": "resources",
                      "type": "object"
                    },
                    "securityContext": {
                      "description": "Container securityContext (no privilege escalation, read-only root\nfilesystem, drops ALL capabilities).",
                      "properties": {
                        "allowPrivilegeEscalation": {
                          "default": false,
                          "title": "allowPrivilegeEscalation",
                          "type": "boolean"
                        },
                        "capabilities": {
                          "properties": {
                            "drop": {
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  }
                                ],
                                "required": []
                              },
                              "title": "drop",
                              "type": "array"
                            }
                          },
                          "required": [],
                          "title": "capabilities",
                          "type": "object"
                        },
                        "readOnlyRootFilesystem": {
                          "default": true,
                          "title": "readOnlyRootFilesystem",
                          "type": "boolean"
                        }
                      },
                      "required": [],
                      "title": "securityContext",
                      "type": "object"
                    }
                  },
                  "required": [],
                  "title": "main",
                  "type": "object"
                }
              },
              "required": [],
              "title": "containers",
              "type": "object"
            },
            "replicas": {
              "default": 2,
              "description": "Number of agent replicas (two give edge-session redundancy).",
              "title": "replicas",
              "type": "integer"
            },
            "strategy": {
              "default": "RollingUpdate",
              "description": "Rolling update keeps an agent serving during upgrades (stateless, 2 replicas).",
              "title": "strategy",
              "type": "string"
            },
            "type": {
              "default": "deployment",
              "title": "type",
              "type": "string"
            }
          },
          "required": [],
          "title": "main",
          "type": "object"
        }
      },
      "required": [],
      "title": "controllers",
      "type": "object"
    },
    "defaultPodOptions": {
      "description": "Pod-wide defaults applied to every controller.",
      "properties": {
        "automountServiceAccountToken": {
          "default": false,
          "description": "The agent does not talk to the cluster API unless directConnect is enabled.",
          "title": "automountServiceAccountToken",
          "type": "boolean"
        },
        "enableServiceLinks": {
          "default": false,
          "title": "enableServiceLinks",
          "type": "boolean"
        },
        "securityContext": {
          "description": "Pod-level securityContext (runs as non-root uid/gid 10001).",
          "properties": {
            "fsGroup": {
              "default": 10001,
              "title": "fsGroup",
              "type": "integer"
            },
            "runAsGroup": {
              "default": 10001,
              "title": "runAsGroup",
              "type": "integer"
            },
            "runAsNonRoot": {
              "default": true,
              "title": "runAsNonRoot",
              "type": "boolean"
            },
            "runAsUser": {
              "default": 10001,
              "title": "runAsUser",
              "type": "integer"
            },
            "seccompProfile": {
              "properties": {
                "type": {
                  "default": "RuntimeDefault",
                  "title": "type",
                  "type": "string"
                }
              },
              "required": [],
              "title": "seccompProfile",
              "type": "object"
            }
          },
          "required": [],
          "title": "securityContext",
          "type": "object"
        },
        "terminationGracePeriodSeconds": {
          "default": 30,
          "description": "Grace period for in-flight streams on shutdown.",
          "title": "terminationGracePeriodSeconds",
          "type": "integer"
        }
      },
      "required": [],
      "title": "defaultPodOptions",
      "type": "object"
    },
    "defaultPodOptionsStrategy": {
      "default": "overwrite",
      "description": "Set the strategy for the default pod options. Defaults to overwrite.\noverwrite: If pod-level options are set, use those instead of the defaults.\nmerge: If pod-level options are set, merge them with the defaults.",
      "title": "defaultPodOptionsStrategy",
      "type": "string"
    },
    "directConnect": {
      "description": "Relay-less direct connectivity: bind a fixed iroh UDP port, expose it as a\nNodePort, and advertise the node IP + nodePort via autodiscovery (also grants\nNode/Service read RBAC and mounts the token).",
      "properties": {
        "annotations": {
          "description": "Annotations for the direct (NodePort) Service.",
          "required": [],
          "title": "annotations",
          "type": "object"
        },
        "enabled": {
          "default": false,
          "description": "Enable relay-less direct connectivity (NodePort + node autodiscovery).",
          "title": "enabled",
          "type": "boolean"
        },
        "irohPort": {
          "default": 51820,
          "description": "Fixed iroh UDP port the agent binds and the NodePort targets (TOWONEL_AGENT_IROH_PORT).",
          "title": "irohPort",
          "type": "integer"
        },
        "nodePort": {
          "default": "null",
          "description": "Explicit nodePort for the iroh UDP port; null lets Kubernetes assign one.",
          "required": [],
          "title": "nodePort",
          "type": [
            "integer",
            "null"
          ]
        }
      },
      "required": [],
      "title": "directConnect",
      "type": "object"
    },
    "disableUdpGso": {
      "default": false,
      "description": "Disable UDP segmentation offload (TOWONEL_DISABLE_UDP_GSO) for pod datapaths\nthat drop offloaded sends.",
      "title": "disableUdpGso",
      "type": "boolean"
    },
    "extraLocalAddrs": {
      "default": "",
      "description": "Reachable local addresses advertised to edges, comma-separated host:port (TOWONEL_AGENT_EXTRA_LOCAL_ADDRS).",
      "title": "extraLocalAddrs",
      "type": "string"
    },
    "global": {
      "properties": {
        "fullnameOverride": {
          "default": "",
          "description": "Override the full release name.",
          "title": "fullnameOverride",
          "type": "string"
        },
        "nameOverride": {
          "default": "",
          "description": "Override the chart name used in resource names.",
          "title": "nameOverride",
          "type": "string"
        }
      },
      "required": [],
      "title": "global",
      "type": "object"
    },
    "hostNetwork": {
      "default": false,
      "description": "Run the agent on the host network (workaround for pod datapaths that break\nQUIC UDP sends). dnsPolicy switches to ClusterFirstWithHostNet.",
      "title": "hostNetwork",
      "type": "boolean"
    },
    "ingress": {
      "description": "  ingress:\n    main:\n      className: nginx\n      hosts:\n        - host: app.example.com\n          paths:\n            - path: /\n              pathType: Prefix\n              service:\n                identifier: main\n                port: http",
      "required": [],
      "title": "ingress",
      "type": "object"
    },
    "monitoring": {
      "description": "Chart-specific monitoring extras rendered by standalone templates\n(common has no first-class PrometheusRule/GrafanaDashboard).",
      "properties": {
        "dashboards": {
          "properties": {
            "annotations": {
              "description": "Annotations added to the dashboard ConfigMap.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Render the Grafana dashboard ConfigMap (for grafana-operator or the\nkube-prometheus-stack sidecar).",
              "title": "enabled",
              "type": "boolean"
            },
            "grafanaOperator": {
              "properties": {
                "allowCrossNamespaceImport": {
                  "default": true,
                  "description": "If true allows for a Grafana in any namespace to access this GrafanaDashboard.",
                  "title": "allowCrossNamespaceImport",
                  "type": "boolean"
                },
                "enabled": {
                  "default": false,
                  "description": "Render a GrafanaDashboard CR (grafana-operator) instead of a sidecar ConfigMap.",
                  "title": "enabled",
                  "type": "boolean"
                },
                "folder": {
                  "default": "",
                  "description": "Folder to create the dashboard in.",
                  "title": "folder",
                  "type": "string"
                },
                "matchLabels": {
                  "description": "Selector labels for the Grafana instance. Must be set when enabled.",
                  "required": [],
                  "title": "matchLabels",
                  "type": "object"
                },
                "resyncPeriod": {
                  "default": "10m",
                  "description": "Resync period for the Grafana operator to check for updates to the dashboard.",
                  "title": "resyncPeriod",
                  "type": "string"
                }
              },
              "required": [],
              "title": "grafanaOperator",
              "type": "object"
            },
            "labels": {
              "description": "Labels added to the dashboard ConfigMap.",
              "required": [],
              "title": "labels",
              "type": "object"
            },
            "namespace": {
              "default": "",
              "description": "Namespace for the dashboard objects; defaults to the release namespace.",
              "title": "namespace",
              "type": "string"
            }
          },
          "required": [],
          "title": "dashboards",
          "type": "object"
        },
        "prometheusRule": {
          "properties": {
            "additionalRuleLabels": {
              "description": "Extra labels added to every alert rule (e.g. cluster).",
              "required": [],
              "title": "additionalRuleLabels",
              "type": "object"
            },
            "annotations": {
              "description": "PrometheusRule annotations.",
              "required": [],
              "title": "annotations",
              "type": "object"
            },
            "enabled": {
              "default": false,
              "description": "Create a PrometheusRule with the agent alerting rules.",
              "title": "enabled",
              "type": "boolean"
            },
            "labels": {
              "description": "PrometheusRule labels.",
              "required": [],
              "title": "labels",
              "type": "object"
            }
          },
          "required": [],
          "title": "prometheusRule",
          "type": "object"
        }
      },
      "required": [],
      "title": "monitoring",
      "type": "object"
    },
    "networkpolicies": {
      "description": "networkPolicy objects to be generated by the chart. Additional\nnetworkPolicies can be added by adding a dictionary key similar to the 'main'\nnetworkPolicy.",
      "required": [],
      "title": "networkpolicies",
      "type": "object"
    },
    "persistence": {
      "description": "  persistence:\n    config:\n      type: persistentVolumeClaim\n      accessMode: ReadWriteOnce\n      size: 1Gi\n      globalMounts:\n        - path: /config\n    tmp:\n      type: emptyDir\n  persistence:\n    config:\n      type: persistentVolumeClaim\n      accessMode: ReadWriteOnce\n      size: 1Gi\n  persistence:\n    config:\n      type: persistentVolumeClaim\n      accessMode: ReadWriteOnce\n      size: 10Gi\n      storageClass: fast-ssd\n      retain: true\n      globalMounts:\n        - path: /config",
      "required": [],
      "title": "persistence",
      "type": "object"
    },
    "podMonitor": {
      "description": "podMonitor objects to be generated by the chart. Additional PodMonitors can\nbe added by adding a dictionary key similar to the 'main' PodMonitor.",
      "required": [],
      "title": "podMonitor",
      "type": "object"
    },
    "rawResources": {
      "description": "Allows for the inclusion of raw Kubernetes resources that are not supported\nby the chart otherwise​",
      "required": [],
      "title": "rawResources",
      "type": "object"
    },
    "rbac": {
      "description": "Configure the Roles and Role Bindings for the chart here",
      "properties": {
        "bindings": {
          "description": "Example entry - rename as needed\nmain:\nSet to false to disable the Role or ClusterRole.\nenabled: true\nSet the type of RBAC resource. Supported values: Role, ClusterRole.\ntype: Role\nAnnotations to set on the item.\nannotations: {}\nLabels to set on the item.\nlabels: {}\nSet the rules for the Role or ClusterRole.\nrules: []\n(string) Override the default resource name. Mutually exclusive with prefix\nand suffix.\nforceRename:\nPrefix to prepend to the resource name. Mutually exclusive with\nforceRename.\nprefix: \"\"\n(string) Suffix to append to the resource name. Defaults to the resource\nidentifier if there are multiple items, otherwise empty. Mutually exclusive\nwith forceRename.\nsuffix:\n(Cluster)RoleBinding objects to be generated by the chart",
          "required": [],
          "title": "bindings",
          "type": "object"
        },
        "roles": {
          "description": "(Cluster)Role objects to be generated by the chart",
          "required": [],
          "title": "roles",
          "type": "object"
        }
      },
      "required": [],
      "title": "rbac",
      "type": "object"
    },
    "relayUrl": {
      "default": "",
      "description": "Relay URL(s), comma-separated (TOWONEL_AGENT_RELAY_URL). Empty uses the hub-advertised relay.",
      "title": "relayUrl",
      "type": "string"
    },
    "route": {
      "description": "Kubernetes Gateway API *Route objects to be generated by the chart.\nAdditional routes can be added by adding a dictionary key similar to the\n'main' route. See https://gateway-api.sigs.k8s.io/references/spec/ for the\nGateway API specification.",
      "required": [],
      "title": "route",
      "type": "object"
    },
    "secrets": {
      "description": "Kubernetes Secrets to be generated by the chart. Be aware that these values\nare not encrypted by default, and could therefore be visible to anybody with\naccess to the values.yaml file. Additional Secrets can be added by adding a\ndictionary key similar to the 'secret' object.",
      "required": [],
      "title": "secrets",
      "type": "object"
    },
    "secretsFromFolder": {
      "description": "Generate Secrets from files in the chart filesystem",
      "properties": {
        "enabled": {
          "default": false,
          "title": "enabled",
          "type": "boolean"
        },
        "overrides": {
          "description": "(string) Base path containing secret subfolders\nbasePath:",
          "required": [],
          "title": "overrides",
          "type": "object"
        }
      },
      "required": [],
      "title": "secretsFromFolder",
      "type": "object"
    },
    "service": {
      "description": "ClusterIP Service exposing the metrics endpoint (port derived from agent.healthPort).",
      "properties": {
        "main": {
          "properties": {
            "controller": {
              "default": "main",
              "title": "controller",
              "type": "string"
            },
            "ports": {
              "properties": {
                "metrics": {
                  "properties": {
                    "port": {
                      "default": 9090,
                      "title": "port",
                      "type": "integer"
                    },
                    "protocol": {
                      "default": "TCP",
                      "title": "protocol",
                      "type": "string"
                    },
                    "targetPort": {
                      "default": "metrics",
                      "title": "targetPort",
                      "type": "string"
                    }
                  },
                  "required": [],
                  "title": "metrics",
                  "type": "object"
                }
              },
              "required": [],
              "title": "ports",
              "type": "object"
            },
            "primary": {
              "default": true,
              "title": "primary",
              "type": "boolean"
            }
          },
          "required": [],
          "title": "main",
          "type": "object"
        }
      },
      "required": [],
      "title": "service",
      "type": "object"
    },
    "serviceAccount": {
      "description": "Kubernetes serviceAccount objects to be generated by the chart",
      "required": [],
      "title": "serviceAccount",
      "type": "object"
